APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
APP_SESSION_COOKIE_SECURE=false
VITE_API_BASE_URL=
VITE_PUBLIC_SIGNUP_ENABLED=true

APP_FAMILY_USERNAME=family
APP_FAMILY_PASSWORD=replace-with-a-strong-password
APP_FAMILY_EMAIL=owner@example.com
APP_SIGNUP_ENABLED=true
APP_AUDIT_RETENTION_DAYS=180

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-gmail-address@gmail.com
APP_PUBLIC_URL=http://localhost:5173
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Keep private object-storage credentials on the backend only.
# Local development stores logos and generated PDFs in the database.
APP_STORAGE_MODE=database
APP_STORAGE_BUCKET=replace-with-private-bucket
APP_STORAGE_REGION=us-east-1
APP_STORAGE_ENDPOINT=
APP_STORAGE_ACCESS_KEY=replace-with-server-only-key
APP_STORAGE_SECRET_KEY=replace-with-server-only-secret
